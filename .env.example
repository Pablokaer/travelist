# Copy to .env (root) and fill in. Never commit real values.
# `supabase start` prints local URL / keys; use those for local development.

# ---------------------------------------------------------------------------
# App (public: bundled into the client, safe to expose)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local: the "ANON_KEY" (or "PUBLISHABLE_KEY") printed by `supabase start` / `supabase status`.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Any MapLibre style URL. Default: OpenFreeMap "liberty" (no key required).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Observability: leave empty to disable (no-op).
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------------------------------------------------------------------------
# Edge Functions (secret: set with `supabase secrets set`, never in the app)
# ---------------------------------------------------------------------------
ORS_API_KEY=
EXCHANGE_RATES_BASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Auth providers (configured in Supabase dashboard / supabase/config.toml)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_WEB=
APPLE_SERVICE_ID=

# ---------------------------------------------------------------------------
# Data pipeline (Python)
# ---------------------------------------------------------------------------
# Contact info for the User-Agent sent to Wikidata / Overpass / Wikimedia APIs.
PIPELINE_CONTACT_EMAIL=
